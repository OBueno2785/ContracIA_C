{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ContractIA: interfaz web",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "src/contractia/app.py", "--server.port", "8501"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "ContractIA: auditoría + chat",
            "type": "debugpy",
            "request": "launch",
            "module": "contractia",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "ContractIA: solo auditoría (sin chat)",
            "type": "debugpy",
            "request": "launch",
            "module": "contractia",
            "args": ["--sin-chat"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
